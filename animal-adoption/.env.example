# ==============================================================================
# Paw Finder Environment Configuration Template (.env.example)
# Duplicate this file as .env and fill in values for local development.
# ==============================================================================

# Application Server (NestJS HTTP Port)
PORT=3000

# PostgreSQL Database Connection String (used by Prisma ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://pawfinder:pawfinder_secret@localhost:5432/pawfinder_db?schema=public"

# Node Environment (development | test | production)
NODE_ENV=development
